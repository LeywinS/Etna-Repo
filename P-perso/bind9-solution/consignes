# conf
touch /etc/bind/named.conf.{local,options,acl,logging,views}
[...]
named-checkconf /etc/bind/named.conf

# data
mkdir -p /var/cache/bind/primary/{internal,external,admin}
touch /var/cache/bind/primary/{internal,external,admin}/example.com
[...]
named-checkzone example.com /var/cache/bind/primary/admin/example.com
named-checkzone example.com /var/cache/bind/primary/internal/example.com
named-checkzone example.com /var/cache/bind/primary/external/example.com

rndc reload example.com IN admin
rndc reload example.com IN internal
rndc reload example.com IN external


